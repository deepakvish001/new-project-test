# ─── Core
NODE_ENV=development
DATABASE_URL=postgresql://bakaya_app:password@localhost:5432/bakaya
REDIS_URL=redis://localhost:6379

# ─── Claude (docs/07-ai-layer.md)
# Leave unset to use an `ant auth login` profile instead.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# ─── WhatsApp (docs/05-whatsapp-layer.md)
# Phase 1: BSP. Phase 2+: Meta Cloud API direct.
WHATSAPP_PROVIDER=bsp                 # bsp | meta_cloud
WHATSAPP_API_BASE=
WHATSAPP_API_TOKEN=
WHATSAPP_APP_SECRET=                  # webhook HMAC verification — treat as DB-password tier
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ─── Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Storage (ap-south-1 only — docs/09-security-dpdp.md)
AWS_REGION=ap-south-1
S3_BUCKET=bakaya-documents
S3_KMS_KEY_ID=

# ─── Tally connector ingest (mTLS)
CONNECTOR_CA_CERT_PATH=
CONNECTOR_INGEST_ENABLED=true

# ─── Ops
SENTRY_DSN=
LOG_LEVEL=info
